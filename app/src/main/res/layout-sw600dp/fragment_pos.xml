<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal" android:padding="16dp" android:background="@drawable/bg_screen" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_weight="0.58" android:layout_width="0dp" android:layout_height="match_parent">
        <TextView android:text="@string/product_catalog" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etProductSearch" android:hint="@string/search_product_code" android:singleLine="true" android:inputType="text" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_search" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnScanProduct" android:text="@string/scan_product" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerProducts" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_weight="0.42" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="16dp" app:cardCornerRadius="22dp" app:cardElevation="3dp" app:cardBackgroundColor="@color/surface">
        <LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:text="@string/current_ticket" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerCart" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><EditText android:id="@+id/etDiscount" android:hint="@string/discount_hint" android:inputType="numberDecimal" android:singleLine="true" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><EditText android:id="@+id/etTax" android:hint="@string/tax_hint" android:inputType="numberDecimal" android:singleLine="true" android:layout_marginStart="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout>
            <Spinner android:id="@+id/spinnerPayment" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/spinnerClient" android:visibility="gone" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnScanClientQr" android:text="@string/identify_client_qr" android:visibility="gone" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/txtCreditClient" android:text="@string/client_not_identified" android:visibility="gone" android:paddingVertical="8dp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/txtCartTotal" android:text="@string/cart_total_initial" android:textColor="@color/primary" android:textSize="26sp" android:textStyle="bold" android:paddingVertical="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><com.google.android.material.button.MaterialButton android:id="@+id/btnCharge" android:text="@string/charge_sale" app:cornerRadius="20dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="270dp"
        android:layout_height="210dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_scanner_frame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseScanner" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/scanner_close" android:textColor="@color/white" />
        <TextView android:id="@+id/txtScannerTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/scanner_title" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnTorch" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/scanner_torch" android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9000000"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:id="@+id/txtScannerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/scanner_instruction" android:textColor="@color/white" android:textSize="14sp" />
        <LinearLayout android:id="@+id/manualEntryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <EditText android:id="@+id/etManualCode" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_search" android:hint="@string/scanner_manual_hint" android:inputType="text" android:paddingHorizontal="14dp" android:singleLine="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnUseManualCode" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginStart="8dp" android:text="@string/scanner_use" app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

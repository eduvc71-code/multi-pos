<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView android:text="Punto de Venta" android:textSize="20sp" android:textStyle="bold" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerProducts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/txtCartTotal" android:text="Total: $0.00" android:textSize="18sp" android:textStyle="bold" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnCharge" android:text="Cobrar venta" android:layout_margin="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
